# Copy this file to ".env" and fill in your own values.
# NEVER commit a real .env file — it is listed in .gitignore.

# MongoDB connection string.
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hack4hack
# Local example: mongodb://127.0.0.1:27017/hack4hack
MONGO_URI=mongodb://127.0.0.1:27017/hack4hack

# Port the API listens on
PORT=5000

# Secret used to sign JWT login tokens — use a long random string in real deployments
JWT_SECRET=change-me-to-a-long-random-string
